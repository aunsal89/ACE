# ==============================================================================
# Autonomous Career Engine (ACE) — Environment Configuration Template
# Copy this file to .env in the project root: cp .env.example .env
# ==============================================================================

CAREER_ENGINE_ENV=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDERS (Only ONE is needed to run for $0 cost)
# ------------------------------------------------------------------------------
# Google Gemini (Recommended Free Tier - https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenRouter (Dynamic Zero-Cost Free Models Cascade - https://openrouter.ai/)
OPENROUTER_API_KEY=

# OpenAI (Optional - https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (Optional - https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. SOURCING APIS (External Aggregators & Email Alert Ingestion)
# ------------------------------------------------------------------------------
# Google Jobs Scraper via SerpApi (100 free searches/month at https://serpapi.com/)
SERPAPI_API_KEY=

# LinkedIn Scraper via Apify ($5 free credit/month at https://apify.com/)
APIFY_API_TOKEN=

# Headless Gmail LinkedIn Job Alert Ingestion & SMTP Notifications
# Uses Gmail 16-character App Password (create at https://myaccount.google.com/apppasswords)
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
IMAP_USER=
IMAP_PASSWORD=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# 3. REAL-TIME MOBILE ALERTS (Telegram Bot)
# ------------------------------------------------------------------------------
# Telegram Bot Alerts (100% Free - create bot via @BotFather, get ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

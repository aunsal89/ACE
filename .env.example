# ==============================================================================
# Career Engine & Portfolio Synchronizer Environment Configuration
# Save this file to: ~/Portfolio/.env (or ~/Portfolio/career-engine/.env)
# ==============================================================================

CAREER_ENGINE_ENV=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. LLM API KEYS (For Fit Scoring & Tailored Application Generation)
# ------------------------------------------------------------------------------
# Primary Default Provider (Free Tier Available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Fallback Provider 1 (Optional - https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Fallback Provider 2 (Optional - https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. SOURCING API KEYS (External Aggregators)
# ------------------------------------------------------------------------------
# Google Jobs Scraper via SerpApi (100 free searches/month at https://serpapi.com/)
SERPAPI_API_KEY=

# LinkedIn Guest Job Scraper via Apify ($5 free credit/month at https://apify.com/)
APIFY_API_TOKEN=

# (Note: Domestic Defense Scrapers - Baykar, Aselsan, Vizyoner Genc, TUSAS, Roketsan
# operate via direct web scraping and DO NOT require any API keys).

# ------------------------------------------------------------------------------
# 3. NOTIFICATION CHANNELS (Telegram Bot & Gmail SMTP)
# ------------------------------------------------------------------------------
# Telegram Bot Alerts (100% Free - create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP Email Alerts (100% Free - uses Gmail 16-character App Password)
SMTP_USER=aunsal89@gmail.com
SMTP_PASSWORD=
NOTIFICATION_EMAIL=aunsal89@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

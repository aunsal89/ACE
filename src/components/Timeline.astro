---
import { getCollection } from 'astro:content';
import { marked } from 'marked';

const cvCollection = await getCollection('cv');
// We expect one file
const cv = cvCollection[0];
const htmlContent = marked.parse(cv?.body || '') as string;
---

<section id="experience" class="py-24 max-w-4xl mx-auto px-6 relative">
  <div class="mb-16 text-center">
    <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight">Professional Experience</h2>
    <p class="text-slate-400 mt-4">15+ years of driving engineering excellence.</p>
  </div>

  <div class="cv-timeline relative bg-slate-900/40 p-8 md:p-12 rounded-3xl border border-slate-800 shadow-2xl backdrop-blur-sm">
    <div 
      class="prose prose-invert prose-slate max-w-none 
             prose-headings:text-slate-100 prose-h1:text-4xl prose-h1:text-center prose-h1:mb-2 prose-h2:text-3xl prose-h2:text-amber-500 prose-h2:border-b prose-h2:border-slate-800 prose-h2:pb-4 prose-h2:mt-16
             prose-h3:text-2xl prose-h3:text-white prose-h3:mt-12
             prose-p:text-slate-300 prose-strong:text-amber-400
             prose-a:text-amber-500 hover:prose-a:text-amber-400
             prose-ul:text-slate-300 prose-li:marker:text-slate-600
             prose-table:w-full prose-th:bg-slate-800 prose-th:p-4 prose-th:text-left prose-td:p-4 prose-td:border-t prose-td:border-slate-800"
      set:html={htmlContent}
    />
  </div>

  <style is:global>
    /* Custom Timeline Styles targeting specific Markdown elements */
    .cv-timeline h3 {
      position: relative;
    }
    .cv-timeline h3::before {
      content: '';
      position: absolute;
      left: -2rem;
      top: 0.6rem;
      width: 0.75rem;
      height: 0.75rem;
      background-color: var(--color-brand-amber);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--color-brand-amber);
    }
    @media (min-width: 768px) {
      .cv-timeline h3::before {
        left: -3rem;
      }
    }
    /* Add a vertical line for the timeline effect on h3 */
    .cv-timeline h3::after {
      content: '';
      position: absolute;
      left: -1.65rem;
      top: 1.5rem;
      width: 2px;
      height: 100%;
      background-color: var(--color-border);
      z-index: -1;
    }
    @media (min-width: 768px) {
      .cv-timeline h3::after {
        left: -2.65rem;
      }
    }
    
    /* Make the paragraphs that immediately follow h3 (usually the date/location) look like meta tags */
    .cv-timeline h3 + p {
      font-family: monospace;
      font-size: 0.875rem;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 0;
      margin-bottom: 1.5rem;
    }
  </style>
</section>

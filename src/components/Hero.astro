---
import { Image } from 'astro:assets';
// Assuming the headshot is in the public directory and we can reference it
// Or we can import it if it's in src/assets. Let's assume public/aunsal_headshot.png
---

<section id="hero" class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden">
  <!-- Background Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-blue/20 rounded-full blur-[120px] -z-10 opacity-50"></div>
  
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    <div class="space-y-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/50 border border-slate-700/50 text-amber-500 text-sm font-medium backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        Available for new opportunities
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white leading-tight">
        Ahmet Halit <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">Ünsal</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-slate-300 font-light leading-relaxed max-w-lg">
        Software Manager &amp; Full-Cycle Product Architect.
      </p>
      
      <p class="text-slate-400 leading-relaxed max-w-lg">
        15+ years spanning safety-critical embedded systems, large-scale team management, and zero-to-production product engineering.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-4">
        <a href="#ventures" class="px-6 py-3 bg-white text-slate-900 font-semibold rounded-lg hover:bg-slate-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)]">
          Explore Ventures
        </a>
        <a href="#experience" class="px-6 py-3 bg-slate-800 text-white font-semibold rounded-lg hover:bg-slate-700 transition-colors border border-slate-700">
          View Experience
        </a>
      </div>
    </div>
    
    <div class="relative flex justify-center md:justify-end z-10">
      <div class="relative w-72 h-72 md:w-96 md:h-96 rounded-2xl overflow-hidden border border-slate-700/50 shadow-2xl group">
        <div class="absolute inset-0 bg-gradient-to-tr from-brand-blue/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
        <img 
          src="/ausnal_headshot.png" 
          alt="Ahmet Halit Ünsal" 
          class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out grayscale hover:grayscale-0"
        />
      </div>
      
      <!-- Tech Stack Floating Badges -->
      <div class="absolute -bottom-6 -left-6 px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl shadow-xl backdrop-blur-md flex items-center gap-2 animate-bounce" style="animation-duration: 3s;">
        <span class="text-blue-400 font-mono text-sm">React Native</span>
      </div>
      <div class="absolute top-12 -right-8 px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl shadow-xl backdrop-blur-md flex items-center gap-2 animate-bounce" style="animation-duration: 4s; animation-delay: 1s;">
        <span class="text-emerald-400 font-mono text-sm">Python / Algo</span>
      </div>
    </div>
  </div>
</section>

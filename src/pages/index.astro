---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Ventures from '../components/Ventures.astro';
import Timeline from '../components/Timeline.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Ahmet Halit Ünsal | Software Manager & Architect">
  <Hero />

  <div class="relative">
    <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[600px] h-[600px] bg-amber-500/10 rounded-full blur-[120px] pointer-events-none"></div>
    <Ventures />
  </div>

  <div class="relative">
    <div class="absolute top-1/3 left-0 -translate-x-1/2 w-[800px] h-[800px] bg-brand-blue/10 rounded-full blur-[100px] pointer-events-none"></div>
    <Timeline />
  </div>

  <Education />

  <div class="relative">
    <div class="absolute top-1/2 right-0 translate-x-1/4 w-[700px] h-[700px] bg-amber-500/5 rounded-full blur-[120px] pointer-events-none"></div>
    <Skills />
  </div>

  <div class="relative">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-brand-blue/10 rounded-full blur-[120px] pointer-events-none"></div>
    <Contact />
  </div>
</Layout>

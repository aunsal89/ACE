[Unit]
Description=Career Engine Autonomous Sourcing & Application Pipeline
Documentation=https://github.com/aunsal89/Portfolio
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nsl
Group=nsl
WorkingDirectory=/home/nsl/Portfolio/career-engine
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/home/nsl/miniconda3/envs/lnxenv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/home/nsl/miniconda3/envs/lnxenv/bin/python /home/nsl/Portfolio/career-engine/run.py pipeline

# Resilience & Error Handling
Restart=on-failure
RestartSec=30s
TimeoutStartSec=600

# Logging & Observability (Streams directly to systemd journal)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=career-sourcing

# Security & Sandboxing Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/nsl/Portfolio/career-engine/data /home/nsl/Portfolio/career-engine/inbox

[Install]
WantedBy=multi-user.target

---
import { getCollection } from 'astro:content';
import { marked } from 'marked';

const cvCollection = await getCollection('cv');
const education = cvCollection.find(e => e.id.toLowerCase() === 'education');
// Strip the leading "# Education" heading — section heading is rendered below.
const educationBody = (education?.body || '').replace(/^#\s+.*\n+/, '');
const htmlContent = marked.parse(educationBody) as string;
---

<section id="education" class="py-24 max-w-4xl mx-auto px-6 relative">
  <div class="mb-12 text-center">
    <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight">Education</h2>
  </div>

  <div class="bg-slate-900/40 p-8 md:p-12 rounded-3xl border border-slate-800 shadow-2xl backdrop-blur-sm">
    <div
      class="prose prose-invert prose-slate max-w-none text-center
             prose-p:text-slate-300 prose-p:text-lg prose-p:leading-relaxed
             prose-strong:text-amber-400
             prose-a:text-amber-500 hover:prose-a:text-amber-400"
      set:html={htmlContent}
    />
  </div>
</section>

# Environment variables and API keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Local databases & model caches (regenerated dynamically on demand)
data/*
!data/.gitkeep

# Local user tenants & private CV sources
config/tenants/*
!config/tenants/.gitkeep

# Generated application packages and review dashboard (regenerated dynamically on demand)
inbox/*
!inbox/.gitkeep

# Operating System & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Node / legacy artifacts
node_modules/
dist/
.astro/
